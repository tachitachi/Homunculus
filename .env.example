# ── Ollama ────────────────────────────────────────────────────────────────────

# URL of the Ollama HTTP server.
# Inside Docker Compose, services reach each other by service name.
# When running the Go binary locally (outside Docker), use localhost.
OLLAMA_BASE_URL=http://ollama:11434

# The Ollama model tag to use for chat completions.
# Must be pulled before use — the model-puller service handles this automatically.
# See available models: https://ollama.com/library
MODEL_NAME=gemma4:e4b

# The Ollama model to use for generating embeddings (Phase 4+).
# nomic-embed-text is fast and small (~274 MB).
EMBED_MODEL_NAME=nomic-embed-text


# ── Agent ─────────────────────────────────────────────────────────────────────

# Maximum number of Thought/Action/Observation iterations before the agent
# gives up and returns whatever it has. Increase if the agent is cutting off
# on complex tasks; decrease to save tokens on simple ones.
AGENT_MAX_ITERATIONS=10

# Maximum coding attempts before the coding agent returns a partial result
# (Phase 5+).
AGENT_MAX_ATTEMPTS=5


# ── Memory ────────────────────────────────────────────────────────────────────

# Number of messages to keep in the sliding window before summarization kicks
# in. Each message pair (user+assistant) counts as 2. Reducing this value
# lowers token usage at the cost of shorter effective memory.
CONVERSATION_MAX_MESSAGES=20


# ── Sandbox ───────────────────────────────────────────────────────────────────

# URL of the sandbox code execution service (Phase 3+).
SANDBOX_URL=http://sandbox:8080

# Default maximum seconds a submitted code snippet is allowed to run.
# The agent can request a different timeout per tool call, up to this value.
SANDBOX_DEFAULT_TIMEOUT=10

# Absolute path inside containers to the shared workspace volume.
WORKSPACE_ROOT=/workspace


# ── ChromaDB ─────────────────────────────────────────────────────────────────

# URL of the ChromaDB HTTP server (Phase 4+).
CHROMA_URL=http://chroma:8000

# ChromaDB collection name used for long-term memory.
CHROMA_COLLECTION=homunculus


# ── API server ────────────────────────────────────────────────────────────────

# Port the cmd/api HTTP server listens on (Phase 4+).
API_PORT=8080


# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: debug | info | warn | error
# Set to "debug" to see every Thought, Action, and Observation in the ReAct loop.
LOG_LEVEL=info


# ── Prompts ───────────────────────────────────────────────────────────────────

# Directory containing prompt text files.
# Mounted as a read-only volume so you can edit prompts without rebuilding.
PROMPTS_DIR=/app/prompts
